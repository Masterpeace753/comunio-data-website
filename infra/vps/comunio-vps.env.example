# Non-secret Compose interpolation inputs only. Copy to
# ~/.config/comunio-vps.env and replace every blank after the image/version and
# numeric-identity checks in README.md. Never add credential values here.
POSTGRES_IMAGE=
POSTGRES_UID=
POSTGRES_GID=
PGDATA=
INGEST_IMAGE=
API_IMAGE=
APP_UID=
APP_GID=
VPS_SECRET_DIR=
VPS_TLS_DIR=
API_ALLOWED_ORIGINS=
# Only for the separately gated compose.https.yaml:
CADDY_IMAGE=
CADDY_UID=
CADDY_GID=
API_DOMAIN=
VPS_CADDY_DATA_DIR=
