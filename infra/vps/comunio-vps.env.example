# Non-secret Compose interpolation inputs only. Copy to
# ~/.config/comunio-vps.env and replace every blank after the image/version and
# numeric-identity checks in README.md. Never add credential values here.
POSTGRES_IMAGE=
POSTGRES_UID=
POSTGRES_GID=
PGDATA=
INGEST_IMAGE=
API_IMAGE=
APP_UID=
APP_GID=
VPS_SECRET_DIR=
VPS_TLS_DIR=
API_ALLOWED_ORIGINS=
