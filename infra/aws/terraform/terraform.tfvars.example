aws_region                   = "eu-central-1"
project_name                 = "comunio"
environment                  = "prod"
create_network               = true
create_database              = true
image_tag                    = "latest"
enable_schedule              = false
assign_public_ip             = true
# Set one of the two options below (not both):
# comunio_snapshot_file      = "/app/tests/sample_snapshot.json"   # fixture mode (no live login)
comunio_credentials_secret_arn = "arn:aws:secretsmanager:<region>:<account>:secret:/comunio/phase2/comuniopy-credentials-XXXXXX"
db_backup_retention_days     = 1
# AP-9.2 login retry/alerting: defaults are 3 attempts, 300s (5 min) apart.
# login_retry_attempts        = 3
# login_retry_wait_seconds    = 300
# alert_sns_topic_arn         = "arn:aws:sns:<region>:<account>:comunio-ingest-alerts"
tags = {
  Owner      = "team-comunio"
  CostCenter = "sports-data"
}