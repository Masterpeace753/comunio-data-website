# Local development settings for AP-5/AP-6
DATABASE_URL=postgresql://comunio:comunio@localhost:5432/comunio_dev

# Use one of the following credential modes:
# 1) AWS Secrets Manager (preferred for AWS environments)
AWS_REGION=eu-central-1
COMUNIO_SECRET_NAME=/comunio/phase2/comuniopy-credentials

# 2) Local fallback for development
COMUNIO_EMAIL=
COMUNIO_PASSWORD=

# Optional AP-7 local fixture mode for deterministic manual tests.
# If set, runner loads teams/players/market_values from this file instead of live API.
COMUNIO_SNAPSHOT_FILE=
